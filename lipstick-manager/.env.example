APP_MODE=admin
ANALYTICS_ENVIRONMENT=development
APP_URL=https://example.vercel.app
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$replace-with-a-real-hash
SESSION_VERSION=1
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
SUPABASE_STORAGE_BUCKET=lipstick-images

# Public demo backend (used when APP_MODE=public-demo)
CLOUDBASE_ENV_ID=replace-with-cloudbase-environment-id
CLOUDBASE_REGION=ap-shanghai
CLOUDBASE_APIKEY=replace-with-server-api-key
CLOUDBASE_STORAGE_BUCKET=lipstick-images
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_API_KEY=replace-with-deepseek-api-key
AI_MAX_COST_CNY=2
AI_USD_CNY_RATE=7.2
LOG_LEVEL=info
